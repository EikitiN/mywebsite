# BEGIN SYSTEM HTTPS SETTING
RewriteEngine on
RewriteOptions inherit
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
ErrorDocument 404 /404.html
# END SYSTEM HTTPS SETTING

# BEGIN REMOVE .html EXTENSION
# 1. .htmlが付いたURLにアクセスした場合、.htmlを削除したURLにリダイレクト
RewriteCond %{THE_REQUEST} \s/([^\s]+)\.html [NC]
RewriteRule ^(.*)\.html$ /$1 [R=301,L]

# 2. .htmlを消して内部で処理するルール
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 3. index.htmlを / にリダイレクトするルール
RewriteCond %{THE_REQUEST} \s/index [NC]
RewriteRule ^index$ / [R=301,L]
# END REMOVE .html EXTENSION